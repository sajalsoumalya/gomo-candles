# Copy to `.secrets` (git-ignored), fill in, then run:  npm run deploy
# Every key here is uploaded as an encrypted Worker secret together with the code.
# Empty or missing keys are skipped; secrets already on Cloudflare are kept (never deleted by a deploy).
# If a value contains $, write it as \$ (or the file will try to expand it).

# --- required
OTP_SECRET=
# Whole service-account JSON on one line, in single quotes:
FIREBASE_SERVICE_ACCOUNT=

# --- WhatsApp codes + order updates (OpenWA on your VPS)
OPENWA_URL=https://wa.example.com
OPENWA_API_KEY=

# --- Email codes + order emails (Postal)
POSTAL_URL=https://postal.example.com
POSTAL_API_KEY=
MAIL_FROM=GoMo Candles <orders@example.com>
MAIL_REPLY_TO=

# --- SMS fallback (optional; choose the provider in Admin → Settings → Sign-in & SMS)
SMS_API_KEY=

# --- Razorpay (optional until you go live with online payment)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- RustFS / S3 storage for photos and files
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# --- Cloudflare Turnstile (optional bot check on sign-in)
TURNSTILE_SECRET=
# --- Shiprocket: "Book pickup" on the order page. Create an API user in Shiprocket → Settings → API
#     (its email must differ from your main login) and put its email + password here.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Exact name of the pickup address in Shiprocket (Settings → Pickup Addresses), e.g. Primary
SHIPROCKET_PICKUP_LOCATION=
# Optional: any long random text; enter the same value as the token in Shiprocket → Settings → API → Webhooks
SHIPROCKET_WEBHOOK_TOKEN=
